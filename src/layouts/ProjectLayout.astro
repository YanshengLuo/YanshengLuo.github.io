---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ProjectHero from "../components/ProjectHero.astro";
import ProjectRail from "../components/ProjectRail.astro";
import ProjectSummary from "../components/ProjectSummary.astro";
import EvidenceOutputs from "../components/EvidenceOutputs.astro";
import PdacEvidenceModel from "../components/PdacEvidenceModel.astro";
import ImrsTransfer from "../components/ImrsTransfer.astro";
import ProteinDecisionFunnel from "../components/ProteinDecisionFunnel.astro";
import RegenerationGallery from "../components/RegenerationGallery.astro";
import ImageDialog from "../components/ImageDialog.astro";
import { researchRoute } from "../data/research";
import { emphasize } from "../utils/format";
interface Props {
  entry: CollectionEntry<"research">;
}
const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const hasFigures = (entry.body ?? "").includes("data-lightbox-trigger");
const projects = {
  pdac: {
    number: "01",
    domain: "Clonal evolution / KRAS",
    visual: "pdac",
    accent: "#7e3949",
    next: "imrs",
    bridge: "From clonal evolution to interpretable response measurement",
  },
  imrs: {
    number: "02",
    domain: "Response scoring / transfer",
    visual: "imrs",
    accent: "#164e73",
    next: "regeneration",
    bridge: "Experimental foundation in comparative tissue repair",
  },
  regeneration: {
    number: "03",
    domain: "Regeneration / repair",
    visual: "drg",
    accent: "#3d6959",
    next: "protein-design",
    bridge: "From experimental phenotype to computational prioritization",
  },
  "protein-design": {
    number: "04",
    domain: "Protein design / ranking",
    visual: "protein",
    accent: "#5d4f8b",
    next: "pdac",
    bridge: "Return to current translational oncology research",
  },
};
type ProjectId = keyof typeof projects;
const project = projects[entry.id as ProjectId];
if (!project) throw new Error("Unknown research page: " + entry.id);
// Project continuity: the next page in the research sequence, in its own accent.
const nextEntry = (await getCollection("research")).find(
  (item) => item.id === project.next,
);
if (!nextEntry) throw new Error("Missing next research entry: " + project.next);
const nextProject = projects[project.next as ProjectId];
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  ogType="article"
>
  <article
    class="container project"
    style={"--project-accent:" + project.accent}
  >
    <ProjectHero data={data} number={project.number} domain={project.domain} />
    <ProjectSummary data={data} />
    <div class="project__visual">
      {project.visual === "drg" ? (
        <RegenerationGallery />
      ) : project.visual === "pdac" ? (
        <PdacEvidenceModel id="project-pdac-evidence" />
      ) : project.visual === "imrs" ? (
        <ImrsTransfer id="project-imrs-transfer" scope={false} />
      ) : (
        <ProteinDecisionFunnel id="project-protein-funnel" />
      )}
    </div>
    <div class="project__reading">
      <aside class="project__sidebar">
        <ProjectRail headings={headings} />
      </aside>
      <div class="prose project__body">
        <Content />
      </div>
    </div>
    <EvidenceOutputs outputs={data.outputs} />
    <a
      class="project-next"
      href={researchRoute(nextEntry.id)}
      style={"--next-accent:" + nextProject.accent}
    >
      <span class="project-next__label">
        Next research · {nextProject.number}
      </span>
      <span class="project-next__copy">
        <strong
          set:html={emphasize(nextEntry.data.homeTitle ?? nextEntry.data.title)}
        />
        <span>{project.bridge}</span>
      </span>
      <span class="project-next__arrow" aria-hidden="true">
        →
      </span>
    </a>
    <p class="project__back">
      <a href="/research/">← All research</a>
    </p>
  </article>
  {hasFigures && <ImageDialog />}
</BaseLayout>
<style>
  .project {
    padding-bottom: var(--space-section);
  }
  .project__visual {
    min-width: 0;
    width: 100%;
    padding: clamp(1rem, 2vw, 2rem);
    background: color-mix(in srgb, var(--project-accent) 6%, white);
    border-top: 2px solid var(--project-accent);
  }
  .project__reading {
    display: grid;
    grid-template-columns: minmax(13rem, 0.8fr) minmax(0, 2.6fr);
    gap: clamp(2rem, 5vw, 5rem);
    max-width: 1120px;
    margin: clamp(3rem, 6vw, 5rem) auto 0;
  }
  .project__sidebar {
    min-width: 0;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h, 70px) + 1.5rem);
  }
  .project__body {
    max-width: 72ch;
    min-width: 0;
  }
  .project__body :global(h2) {
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in srgb, var(--project-accent) 30%, white);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    letter-spacing: -0.04em;
  }
  .project__body :global(.scope) {
    border-color: var(--project-accent);
    background: color-mix(in srgb, var(--project-accent) 7%, white);
  }
  .project__body :global(figure) {
    width: 100%;
    max-width: 100%;
    margin-block: 3rem;
  }
  .project__body :global(figure img) {
    width: 100%;
    max-height: 650px;
    object-fit: contain;
    background: #f4f6f5;
    border: 0;
    border-radius: 0;
  }
  /* Photographs (not figures) fill their frame instead of letterboxing. */
  .project__body :global(figure.figure--photo) {
    margin-block: 2.5rem 0;
  }
  .project__body :global(figure.figure--photo img) {
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: none;
    border-radius: var(--radius);
  }

  /* Next research: the following project's accent, a quiet sweep on hover. */
  .project-next {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.5rem 1.25rem;
    align-items: center;
    max-width: 1030px;
    margin: clamp(4rem, 7vw, 7rem) auto 0;
    padding: 1.25rem 1rem 1.25rem 0;
    overflow: hidden;
    border-top: 2px solid var(--next-accent);
    color: var(--text);
    text-decoration: none;
  }
  .project-next::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--next-accent) 7%, white),
      transparent 70%
    );
    transform: translateX(-102%);
    transition: transform 380ms var(--motion-ease);
  }
  .project-next:hover::before,
  .project-next:focus-visible::before {
    transform: none;
  }
  .project-next__label {
    color: var(--next-accent);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .project-next__copy {
    min-width: 0;
  }
  .project-next__copy strong {
    display: block;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.16;
    transition: transform var(--motion-ui) var(--motion-ease);
  }
  .project-next__copy span {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .project-next__arrow {
    color: var(--next-accent);
    font-size: 1.4rem;
    transition: transform var(--motion-ui) var(--motion-ease);
  }
  .project-next:hover .project-next__copy strong,
  .project-next:focus-visible .project-next__copy strong {
    transform: translateX(3px);
  }
  .project-next:hover .project-next__arrow,
  .project-next:focus-visible .project-next__arrow {
    transform: translateX(6px);
  }

  .project__back {
    max-width: 1030px;
    margin: 1rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--project-accent) 30%, white);
    font-size: 0.9rem;
  }
  .project__back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--project-accent);
    font-weight: 650;
    text-decoration: none;
  }
  .project__back a:hover {
    text-decoration: underline;
  }
  @media (max-width: 1023px) {
    .project__reading {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .project__sidebar {
      position: static;
    }
    .project__body {
      max-width: none;
    }
  }
  @media (max-width: 719px) {
    .project__body {
      grid-column: 1 / -1;
    }
    .project__visual {
      padding: 1rem;
    }
    .project-next {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .project-next__label {
      grid-column: 1 / -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-next::before,
    .project-next__copy strong,
    .project-next__arrow {
      transition: none;
    }
    .project-next:hover .project-next__copy strong,
    .project-next:focus-visible .project-next__copy strong,
    .project-next:hover .project-next__arrow,
    .project-next:focus-visible .project-next__arrow {
      transform: none;
    }
  }
</style>
