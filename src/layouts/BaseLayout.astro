---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/inter/wght-italic.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article" | "profile";
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogType = "website",
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="author" content="Yansheng Luo" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Yansheng Luo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Yansheng Luo — undergraduate researcher at the University of Florida studying treatment response, clonal evolution, and transcriptomic response scoring." />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Marks the document as script-capable before first paint so the mobile
         menu can replace the plain navigation row. -->
    <script is:inline>document.documentElement.setAttribute("data-js", "");</script>

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/navigation";
      import "../scripts/interactions";
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
