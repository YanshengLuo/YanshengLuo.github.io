---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import PageHeader from "../components/PageHeader.astro";
import OutsideResearch from "../components/OutsideResearch.astro";
import ImageDialog from "../components/ImageDialog.astro";
import { aboutNarrative, education, teaching } from "../data/profile";
import { emphasize } from "../utils/format";
---
<BaseLayout title="About | Yansheng Luo" description="Yansheng Luo studies biology and chemistry at the University of Florida, with minors in bioinformatics and statistics, and works across experimental biology, genomics, and translational cancer research.">
  <div class="container about">
    <PageHeader
      index="03"
      section="About"
      title="About"
      lede="The person behind the research: research path, education, teaching, and life outside the lab."
      accent="#3c6657"
      facts={[
        { label: "Current focus", value: "Translational oncology" },
        { label: "Research groups", value: "Maden Lab · Song Lab · MD Anderson ITERT" },
        { label: "Outside research", value: "Diving · photography · outreach" },
      ]}
    >
      <nav class="page-jump" aria-label="About sections">
        <a href="#research-path">Research path</a>
        <a href="#education">Education</a>
        <a href="#teaching">Teaching</a>
        <a href="#outside">Outside research</a>
        <a href="#contact">Contact</a>
      </nav>
    </PageHeader>
    <section class="about__block about__block--lead" id="research-path" aria-labelledby="research-path-title">
      <div class="about__rail"><span>01</span><h2 id="research-path-title">Research path</h2></div>
      <div class="about__prose about__prose--lead">
        {aboutNarrative.map((paragraph) => <p set:html={emphasize(paragraph)} />)}
      </div>
    </section>
    <div class="about__facts">
      <section class="about__block" id="education" aria-labelledby="education-title">
        <div class="about__rail"><span>02</span><h2 id="education-title">Education</h2></div>
        <div class="about__prose">
          <p class="about__school">{education.institution}</p>
          <p class="about__degrees">{education.degrees.join(" · ")}<br />{education.minors}</p>
          <p class="meta">{education.expected} · {education.gpa}</p>
        </div>
      </section>
      <section class="about__block" id="teaching" aria-labelledby="teaching-title">
        <div class="about__rail"><span>03</span><h2 id="teaching-title">Teaching &amp; mentorship</h2></div>
        <div class="about__prose"><p>{teaching}</p></div>
      </section>
    </div>
    <OutsideResearch />
    <section class="about__block about__contact" id="contact" aria-labelledby="contact-title">
      <div class="about__rail"><span>04</span><h2 id="contact-title">Contact</h2></div>
      <div class="about__prose"><SocialLinks /></div>
    </section>
  </div>
  <ImageDialog />
</BaseLayout>
<style>
  .about { padding-bottom: var(--space-section); }
  .about__block { display: grid; gap: 1.5rem 3rem; padding-block: clamp(2.5rem, 4vw, 4rem); border-bottom: 1px solid var(--border); }
  .about__rail { display: flex; align-items: baseline; gap: 1rem; }
  .about__rail span { color: #3c6657; font-size: .72rem; font-weight: 700; }
  .about__rail h2 { font-size: .9rem; font-weight: 650; letter-spacing: .01em; }
  .about__prose { display: grid; align-content: start; gap: 1rem; max-width: 650px; }
  /* Research path: one lead paragraph at a moderate display size, then body text. */
  .about__prose--lead { max-width: 960px; gap: 1.25rem 3rem; font-size: clamp(1.05rem, 1.25vw, 1.15rem); line-height: 1.68; }
  .about__prose--lead p { color: var(--ink-2); }
  .about__prose--lead p:first-child { max-width: 42em; color: var(--text); font-size: clamp(1.3rem, 1.85vw, 1.6rem); line-height: 1.45; letter-spacing: -.018em; }
  .about__school { font-size: 1.1rem; font-weight: 600; }
  .about__degrees { color: var(--muted); }
  .about__facts { display: grid; gap: 3rem; }
  @media (min-width: 1200px) {
    .about__block { grid-template-columns: minmax(0, 2fr) minmax(0, 10fr); }
    /* The two follow-on paragraphs share the width beneath the lead. */
    .about__prose--lead { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about__prose--lead p:first-child { grid-column: 1 / -1; margin-bottom: .5rem; }
    .about__facts { grid-template-columns: 1fr 1fr; }
    .about__facts .about__block { grid-template-columns: 1fr; }
    }
</style>
