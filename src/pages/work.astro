---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkItem from "../components/WorkItem.astro";
import { workSections, type WorkEntry } from "../data/work";
import { figures } from "../data/figures";
import { RESEARCH_ROUTES } from "../data/research";
import posterThumbnail from "../assets/research/regeneration/poster-thumbnail.webp";

// Desktop hover/focus previews for outputs linked to a research project. Images
// are used only where an approved public asset exists (the Acomys microscopy
// and poster); the other projects preview as a compact text card.
const drgPreview = await getImage({ src: figures["drg-culture"].src, width: 640, format: "webp" });
const posterPreview = await getImage({ src: posterThumbnail, width: 640, format: "webp" });
const projectPreviews: Record<string, { label: string; accent: string; meta: string }> = {
  [RESEARCH_ROUTES.pdac]: { label: "PDAC · clonal evolution", accent: "#7e3949", meta: "Barcode lineage tracing · KRAS suppression · robustness" },
  [RESEARCH_ROUTES.imrs]: { label: "IMRS · response scoring", accent: "#1d6288", meta: "Frozen transcriptomic definition · independent transfer" },
  [RESEARCH_ROUTES.regeneration]: { label: "Acomys · regeneration", accent: "#3d6959", meta: "DRG explants · peripheral nerve repair · imaging" },
  [RESEARCH_ROUTES["protein-design"]]: { label: "Protein design", accent: "#5d4f8b", meta: "Candidate prioritization · docking · rank stability" },
};
const previewFor = (entry: WorkEntry, sectionId: string) => {
  const project = entry.project ? projectPreviews[entry.project] : undefined;
  if (!project) return undefined;
  const image =
    entry.project !== RESEARCH_ROUTES.regeneration
      ? undefined
      : sectionId === "publications"
        ? { image: drgPreview.src, alt: figures["drg-culture"].alt }
        : { image: posterPreview.src, alt: "Public research poster from the Acomys comparative regeneration study." };
  return { ...project, ...image };
};
---
<BaseLayout title="Work | Yansheng Luo" description="Publications, manuscripts, presentations, recognition, and teaching by Yansheng Luo, University of Florida.">
  <div class="container work">
    <header class="work__head">
      <p class="work__index">02 / Selected work</p>
      <h1>Work</h1>
      <p class="work__lede">Publications, presentations, recognition, and teaching.</p>
    </header>
    <nav class="work__jump" aria-label="Work sections">
      {workSections.map((section, i) => <a href={"#" + section.id}><span>{"0" + (i + 1)}</span>{section.heading}</a>)}
    </nav>
    {workSections.map((section, i) => (
      <section class="work__section" id={section.id} aria-labelledby={section.id + "-title"}>
        <div class="work__rail"><span>{"0" + (i + 1)}</span><h2 id={section.id + "-title"}>{section.heading}</h2></div>
        <ol class="work__list">{section.entries.map((entry) => <WorkItem entry={entry} preview={previewFor(entry, section.id)} />)}</ol>
      </section>
    ))}
  </div>
  <aside class="work-preview" aria-hidden="true" data-work-preview>
    <img class="work-preview__image" alt="" width="640" height="400" decoding="async" hidden data-work-preview-image />
    <p class="work-preview__eyebrow" data-work-preview-label></p>
    <p class="work-preview__title" data-work-preview-title></p>
    <p class="work-preview__meta" data-work-preview-meta></p>
    <p class="work-preview__hint"><span>Related research</span><span>↗</span></p>
  </aside>
  <script>
    import "../scripts/work-preview";
  </script>
</BaseLayout>
<style>
  .work { padding-bottom: var(--space-section); }
  .work__head { display: grid; gap: 1rem; padding-block: clamp(4rem, 7vw, 7rem); border-bottom: 2px solid #334e62; }
  @media (max-width: 47.99rem) { .work__head { padding-top: 2.5rem; } }
  .work__index { color: #334e62; font-size: .7rem; font-weight: 700; letter-spacing: .075em; text-transform: uppercase; }
  .work__head h1 { font-size: var(--type-hero); line-height: 1; letter-spacing: -.05em; }
  .work__lede { max-width: 40ch; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.2rem); }
  .work__jump { display: flex; flex-wrap: wrap; gap: .5rem; padding-block: 1.5rem; border-bottom: 1px solid var(--border); }
  .work__jump a { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; padding: .55rem .75rem; border: 1px solid var(--border); color: var(--text); font-size: .75rem; font-weight: 650; text-decoration: none; }
  .work__jump a:hover { border-color: #334e62; color: #334e62; }
  .work__jump span, .work__rail span { color: #45677f; font-size: .7rem; font-weight: 700; }
  .work__section { display: grid; gap: 1.5rem 3rem; padding-block: clamp(3rem, 5vw, 5rem); border-bottom: 1px solid var(--border); }
  .work__rail h2 { margin-top: .7rem; font-size: clamp(1.7rem, 2.5vw, 2.4rem); letter-spacing: -.045em; }
  .work__list { margin: 0; padding: 0; list-style: none; }
  .work__list :global(.wi:first-child) { border-top: 0; }
  .work__list :global(.wi) { padding-block: 1.5rem; }
  .work__list :global(.wi__title) { font-size: clamp(1rem, 1.4vw, 1.2rem); font-weight: 600; }
  @media (min-width: 1200px) {
    .work__head, .work__section { grid-template-columns: minmax(0, 2fr) minmax(0, 10fr); }
    .work__head h1, .work__lede { grid-column: 2; }
    .work__jump { padding-left: calc(100% / 6 + 3rem); }
  }

  /* Floating preview: fixed-position, so the record layout never moves. */
  .work-preview { position: fixed; left: 0; top: 0; z-index: 45; width: min(280px, calc(100vw - 2rem)); padding: .9rem; border: 1px solid color-mix(in srgb, var(--preview-accent, #164e73) 40%, white); border-top: 3px solid var(--preview-accent, #164e73); border-radius: 14px; background: rgba(250, 252, 253, .96); box-shadow: 0 20px 55px rgba(20, 42, 58, .2); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); opacity: 0; visibility: hidden; pointer-events: none; transform: translate3d(var(--preview-x, 0), var(--preview-y, 0), 0) scale(.97); transform-origin: top left; transition: opacity var(--motion-micro) var(--motion-ease), transform var(--motion-ui) var(--motion-ease), visibility 0s linear var(--motion-micro); }
  .work-preview.is-visible { opacity: 1; visibility: visible; transform: translate3d(var(--preview-x, 0), var(--preview-y, 0), 0); transition: opacity var(--motion-micro) var(--motion-ease), transform var(--motion-ui) var(--motion-ease), visibility 0s; }
  .work-preview__image { width: 100%; aspect-ratio: 2 / 1; margin-bottom: .7rem; border-radius: 8px; background: #eef2f0; object-fit: cover; }
  .work-preview__image[hidden] { display: none; }
  .work-preview__eyebrow { color: var(--preview-accent, #164e73); font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .work-preview__title { margin-top: .5rem; display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; font-size: .95rem; font-weight: 650; line-height: 1.28; letter-spacing: -.015em; }
  .work-preview__meta { margin-top: .55rem; color: #687681; font-size: .72rem; line-height: 1.45; }
  .work-preview__hint { display: flex; justify-content: space-between; align-items: center; margin-top: .85rem; padding-top: .6rem; border-top: 1px solid #dbe4ea; color: #566c7a; font-size: .66rem; font-weight: 700; letter-spacing: .055em; text-transform: uppercase; }
  @media (max-width: 1199px), (hover: none) { .work-preview { display: none; } }
  @media (prefers-reduced-motion: reduce) { .work-preview, .work-preview.is-visible { transform: translate3d(var(--preview-x, 0), var(--preview-y, 0), 0); transition: none; } }
</style>
