---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { workSections } from "../data/work";
import { RESEARCH_LABELS } from "../data/research";
import { emphasize } from "../utils/format";

const count = workSections.reduce(
  (total, section) => total + section.entries.length,
  0,
);
---

<BaseLayout
  title="Work & Outputs | Yansheng Luo"
  description="Publications, manuscripts, presentations, public research outputs, recognition, teaching, and mentorship by Yansheng Luo."
>
  <div class="container work-page">
    <PageHeader
      index="02"
      section="Work & Outputs"
      title="Work, shared."
      lede="Publications and manuscripts, presentations, public project materials, and the teaching that accompanies the research."
      facts={[
        {
          label: "Record",
          value: `${count} entries across ${workSections.length} sections`,
        },
        {
          label: "Manuscripts",
          value: "1 accepted · 1 prepared for submission",
        },
        {
          label: "Research",
          value: "View project context",
          href: "/research/",
        },
      ]}
    />

    <form
      class="work-tools"
      data-work-tools
      hidden
      role="search"
      aria-label="Search the work record"
    >
      <label>
        Search the record
        <input
          type="search"
          name="q"
          placeholder="Title, method, year, or venue"
          data-work-query
          autocomplete="off"
        />
      </label>
      <label>
        Project
        <select name="project" data-work-project>
          <option value="">All projects and records</option>
          {Object.entries(RESEARCH_LABELS).map(([route, label]) => (
            <option value={route}>{label}</option>
          ))}
        </select>
      </label>
      <button type="reset">Clear filters</button>
      <p data-work-count role="status" aria-live="polite">
        Showing {count} of {count} entries
      </p>
    </form>
    <div class="work-layout">
      <nav class="work-nav" aria-label="Work sections">
        <p>On this page</p>
        {workSections.map((section, index) => (
          <a href={`#${section.id}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {section.heading}
          </a>
        ))}
      </nav>

      <div class="work-record">
        <p class="work-empty" data-work-empty hidden>
          No matching records. Try a broader term or clear the filters above.
        </p>
        {workSections.map((section, sectionIndex) => (
          <section
            class="work-section"
            id={section.id}
            aria-labelledby={`${section.id}-title`}
          >
            <header class="work-section__head">
              <span>{String(sectionIndex + 1).padStart(2, "0")}</span>
              <h2 id={`${section.id}-title`}>{section.heading}</h2>
              <span data-section-count>
                {section.entries.length}{" "}
                {section.entries.length === 1 ? "entry" : "entries"}
              </span>
            </header>

            <ol class="work-list">
              {section.entries.map((entry) => (
                <li
                  class="work-entry"
                  data-work-entry
                  data-project={entry.project ?? ""}
                >
                  <p class="work-entry__date">{entry.when ?? "Current"}</p>
                  <div class="work-entry__body">
                    {entry.status && (
                      <p class="work-entry__status">{entry.status}</p>
                    )}
                    {entry.authors && (
                      <p class="work-entry__authors">{entry.authors}</p>
                    )}
                    <h3 set:html={emphasize(entry.title)} />
                    {entry.venue && (
                      <p
                        class="work-entry__venue"
                        set:html={emphasize(entry.venue)}
                      />
                    )}
                    {entry.detail && (
                      <p class="work-entry__detail">{entry.detail}</p>
                    )}
                    {(entry.project || entry.href) && (
                      <div class="work-entry__links">
                        {entry.project && (
                          <a href={entry.project}>
                            {RESEARCH_LABELS[entry.project]}{" "}
                            <span aria-hidden="true">→</span>
                          </a>
                        )}
                        {entry.href && (
                          <a href={entry.href} target="_blank" rel="noreferrer">
                            View public output <span aria-hidden="true">↗</span>
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import "../scripts/work-filter";
</script>

<style>
  .work-page {
    padding-bottom: var(--section-y);
  }
  .work-layout {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .work-nav {
    align-self: start;
    border-top: 2px solid var(--accent);
  }
  .work-nav p {
    padding-block: 0.85rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }
  .work-nav a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: baseline;
    min-height: 44px;
    padding-block: 0.72rem;
    border-top: 1px solid var(--border);
    color: var(--ink-2);
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.35;
    text-decoration: none;
  }
  .work-nav a:last-child {
    border-bottom: 1px solid var(--border);
  }
  .work-nav a:hover {
    color: var(--accent);
  }
  .work-nav a span {
    color: var(--accent);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }
  .work-record {
    min-width: 0;
  }
  .work-section {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .work-section + .work-section {
    margin-top: clamp(3.5rem, 7vw, 6.5rem);
  }
  .work-section__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--text);
  }
  .work-section__head h2 {
    font-size: clamp(1.55rem, 2.2vw, 2.15rem);
    letter-spacing: -0.025em;
  }
  .work-section__head > span {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .work-section__head > span:first-child {
    color: var(--accent);
  }
  .work-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work-entry {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 3.25rem);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--border);
  }
  .work-entry__date {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .work-entry__body {
    max-width: 52rem;
  }
  .work-entry__status {
    display: inline-flex;
    margin-bottom: 0.8rem;
    padding: 0.28rem 0.48rem;
    background: var(--accent-light);
    color: var(--accent);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .work-entry__authors,
  .work-entry__venue,
  .work-entry__detail {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .work-entry__authors {
    margin-bottom: 0.35rem;
    color: var(--ink-2);
  }
  .work-entry h3 {
    max-width: 48rem;
    font-size: clamp(1.06rem, 1.5vw, 1.3rem);
    font-weight: 600;
    line-height: 1.42;
  }
  .work-entry__venue,
  .work-entry__detail {
    margin-top: 0.5rem;
  }
  .work-entry__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: 1rem;
  }
  .work-entry__links a {
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (min-width: 60rem) {
    .work-layout {
      grid-template-columns: 13.5rem minmax(0, 1fr);
    }
    .work-nav {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
  @media (max-width: 47.99rem) {
    .work-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .work-nav p {
      grid-column: 1 / -1;
    }
    .work-nav a {
      padding-right: 0.75rem;
    }
    .work-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.65rem;
    }
  }
  @media (max-width: 28rem) {
    .work-nav {
      grid-template-columns: minmax(0, 1fr);
    }
    .work-nav p {
      grid-column: auto;
    }
    .work-section__head {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .work-section__head > span:last-child {
      display: none;
    }
  }

  .work-tools {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: end;
    margin-top: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .work-tools[hidden],
  .work-entry[hidden],
  .work-section[hidden],
  .work-empty[hidden],
  .work-nav a[hidden] {
    display: none;
  }
  .work-tools label {
    display: grid;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 650;
    color: var(--ink-2);
  }
  .work-tools input,
  .work-tools select {
    min-width: 0;
    width: 100%;
    min-height: 46px;
    border: 1px solid #8e9ca7;
    border-radius: 3px;
    background: white;
    padding: 0.65rem 0.8rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--text);
  }
  .work-tools button {
    min-height: 46px;
    padding: 0.65rem 1rem;
    font: inherit;
    font-size: 0.8rem;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--accent);
    cursor: pointer;
  }
  .work-tools > p {
    grid-column: 1/-1;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .work-nav a[aria-current] {
    color: var(--accent);
    font-weight: 750;
    border-left: 2px solid var(--accent);
    padding-left: 0.6rem;
  }
  .work-empty {
    padding-block: 2rem;
    color: var(--ink-2);
  }
  @media (max-width: 47.99rem) {
    .work-tools {
      grid-template-columns: 1fr;
    }
    .work-tools button {
      justify-self: start;
    }
  }
</style>
