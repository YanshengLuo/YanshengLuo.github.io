---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="Page not found | Yansheng Luo" description="This page does not exist." noindex>
  <section class="container nf" aria-labelledby="nf-title">
    <p class="meta">404</p>
    <h1 id="nf-title">Page not found</h1>
    <p>The page you were looking for does not exist or has moved.</p>
    <div class="nf__actions">
      <Button href="/" arrow>Go to the homepage</Button>
      <Button href="/cv/" variant="plain">View CV</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(4rem, 12vw, 9rem);
  }

  .nf h1 {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 5rem);
  }

  .nf p:not(.meta) {
    color: var(--muted);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
