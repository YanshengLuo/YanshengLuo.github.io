---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { site } from "../data/profile";
---

<BaseLayout
  title="Curriculum Vitae | Yansheng Luo"
  description="Curriculum vitae of Yansheng Luo, undergraduate researcher at the University of Florida (PDF)."
>
  <section class="container cv" aria-labelledby="cv-title">
    <div class="cv__head">
      <div>
        <h1 id="cv-title">Curriculum Vitae</h1>
        <p class="cv__updated">Last updated: {site.cvUpdated}</p>
      </div>
      <div class="cv__actions">
        <Button href={site.cvPath}>Open PDF</Button>
        <Button href={site.cvPath} variant="plain" download="Yansheng_Luo_CV.pdf">Download PDF</Button>
      </div>
    </div>

    <div class="cv__viewer">
      <iframe
        src={`${site.cvPath}#view=FitH`}
        title="Curriculum vitae of Yansheng Luo, PDF preview"
        loading="lazy"
      ></iframe>
    </div>

    <p class="cv__fallback">
      PDF, 4 pages, 252 KB. If the preview does not display, <a href={site.cvPath}>open the CV as a PDF</a
      >.
    </p>
  </section>
</BaseLayout>

<style>
  .cv {
    padding-block: clamp(2.5rem, 7vw, 5rem) var(--space-section);
  }

  .cv__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-bottom: 2rem;
  }

  .cv h1 {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 5rem);
    letter-spacing: -0.022em;
  }

  .cv__updated {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .cv__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* The embedded preview is a convenience on larger screens only;
     the buttons above are the primary way to reach the PDF. */
  .cv__viewer {
    display: none;
  }

  @media (min-width: 48rem) {
    .cv__viewer {
      display: block;
      height: min(88vh, 1100px);
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .cv__viewer iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
  }

  .cv__fallback {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
