---
import BaseLayout from "../layouts/BaseLayout.astro";
import { readFileSync } from "node:fs";
import path from "node:path";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/profile";
import { EMAIL, links } from "../data/social";

// File facts are read from the published PDF at build time, so they stay correct when the CV is replaced.
const pdf = readFileSync(path.join(process.cwd(), "public", site.cvPath)).toString("latin1");
const sizeKb = Math.round(pdf.length / 1024);
const pageCount =
  Number(pdf.match(/\/Type\s*\/Pages[^>]*?\/Count\s+(\d+)/)?.[1]) || (pdf.match(/\/Type\s*\/Page(?![s\w])/g) ?? []).length;
const fileSummary = ["PDF", pageCount ? `${pageCount} pages` : "", `${sizeKb} KB`].filter(Boolean).join(" · ");
---

<BaseLayout
  title="Curriculum Vitae | Yansheng Luo"
  description="Curriculum vitae of Yansheng Luo, undergraduate researcher at the University of Florida (PDF)."
>
  <section class="container cv" aria-labelledby="cv-title">
    <PageHeader
      index="04"
      section="CV"
      title="Curriculum Vitae"
      titleId="cv-title"
      lede="Education, research experience, publications, presentations, awards, teaching, and training."
      facts={[
        { label: "Last updated", value: site.cvUpdated },
        { label: "Format", value: fileSummary },
        { label: "Contact", value: EMAIL, href: links.email },
      ]}
    >
      <div class="cv__actions">
        <Button href={site.cvPath}>Open PDF</Button>
        <Button href={site.cvPath} variant="plain" download="Yansheng_Luo_CV.pdf">Download PDF</Button>
      </div>
    </PageHeader>

    <div class="cv__viewer">
      <iframe
        src={`${site.cvPath}#view=FitH`}
        title="Curriculum vitae of Yansheng Luo, PDF preview"
        loading="lazy"
      ></iframe>
    </div>

    <p class="cv__fallback">
      {fileSummary}. If the preview does not display, <a href={site.cvPath}>open the CV as a PDF</a
      >.
    </p>
  </section>
</BaseLayout>

<style>
  .cv {
    padding-bottom: var(--space-section);
  }

  .cv__viewer {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .cv__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* The embedded preview is a convenience on larger screens only;
     the buttons above are the primary way to reach the PDF. */
  .cv__viewer {
    display: none;
  }

  @media (min-width: 48rem) {
    .cv__viewer {
      display: block;
      height: min(88vh, 1100px);
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .cv__viewer iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
  }

  .cv__fallback {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
