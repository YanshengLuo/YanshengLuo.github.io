---
import { Image, getImage } from "astro:assets";
import scuba from "../assets/profile/scuba.webp";
import boba from "../assets/profile/science-boba.webp";
import lizard from "../assets/photography/lizard-hollow.webp";
import snake from "../assets/photography/snake-branch.webp";
import { beyondResearch, outsideSlides } from "../data/profile";
import { links } from "../data/social";
const photos = await Promise.all(
  [
    {
      src: lizard,
      alt: "A green lizard resting inside a dark hollow in a tree trunk, lit by a narrow shaft of light.",
    },
    {
      src: snake,
      alt: "A green snake coiled along a bare branch against a black background.",
    },
  ].map(async (photo) => ({
    ...photo,
    full: await getImage({ src: photo.src, width: 1600, format: "webp" }),
  })),
);
---

<section
  class="fieldnotes dark"
  id="outside"
  aria-labelledby="outside-title"
  data-fieldnotes
>
  <div class="fieldnotes-top">
    <h2 id="outside-title">Beyond the lab.</h2>
    <div
      class="fieldnotes-controls"
      data-note-controls
      hidden
      aria-label="Choose a fieldnote"
    >
      {["Diving", "Photography", "Outreach"].map((label) => (
        <button
          type="button"
          data-note-select={label.toLowerCase()}
          aria-controls={"note-" + label.toLowerCase()}
          aria-pressed={label === "Diving" ? "true" : "false"}
        >
          {label}
        </button>
      ))}
    </div>
  </div>
  <article class="fieldnote" data-note="diving" id="note-diving">
    <div>
      <p class="fieldnote__index">01 / Under the surface</p>
      <h3>
        A different way
        <br />
        to observe.
      </h3>
      <p>{beyondResearch}</p>
      <a
        class="text-link"
        href={links.fantasticSea}
        target="_blank"
        rel="noreferrer"
      >
        Visit FantasticSea <span aria-hidden="true">↗</span>
      </a>
    </div>
    <figure>
      <Image
        src={scuba}
        alt="Yansheng Luo in scuba gear at the surface of a clear freshwater spring."
        widths={[500, 800, 1200]}
        sizes="(max-width:850px) 85vw, 650px"
        loading="lazy"
      />
      <figcaption>Diving / Outside research</figcaption>
    </figure>
  </article>
  <article class="fieldnote" data-note="photography" id="note-photography">
    <div>
      <p class="fieldnote__index">02 / Through the lens</p>
      <h3>Looking closely.</h3>
      <p>I also photograph wildlife. Both photographs here are my own.</p>
      <p class="fieldnote__hint">Select a photograph to see it in full.</p>
    </div>
    <div class="fieldnote-photos">
      {photos.map((photo) => (
        <figure>
          <a
            href={photo.full.src}
            data-lightbox-trigger
            data-full={photo.full.src}
            data-width={photo.full.attributes.width}
            data-height={photo.full.attributes.height}
            data-alt={photo.alt}
            data-caption="Photograph by Yansheng Luo."
            aria-label="Enlarge wildlife photograph"
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[400, 700]}
              sizes="(max-width:600px) 80vw, 300px"
              loading="lazy"
            />
          </a>
          <figcaption>Photograph by Yansheng Luo</figcaption>
        </figure>
      ))}
    </div>
  </article>
  <article class="fieldnote" data-note="outreach" id="note-outreach">
    <div>
      <p class="fieldnote__index">03 / Sharing science</p>
      <h3>
        Making ideas
        <br />
        tangible.
      </h3>
      <p>{outsideSlides.outreach}</p>
    </div>
    <figure>
      <Image
        src={boba}
        alt="Yansheng Luo beside his Science Boba polymer chemistry demonstration board."
        widths={[480, 720, 960]}
        sizes="(max-width:850px) 85vw, 650px"
        loading="lazy"
      />
      <figcaption>Science Boba / ITERT Science Fair, 2026</figcaption>
    </figure>
  </article>
</section>

<script>
  import "../scripts/fieldnotes";
</script>

<style>
  .fieldnotes {
    overflow: hidden;
    background: var(--bg-about);
    border-radius: 8px;
    color: #d8e4ea;
    box-shadow: none;
  }

  .fieldnotes h2,
  .fieldnotes h3 {
    color: #fff;
  }

  .fieldnotes-top {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .fieldnotes-top h2 {
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    letter-spacing: -0.04em;
  }

  .fieldnotes-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .fieldnotes-controls button {
    min-height: 42px;
    padding: 0.5rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: transparent;
    color: #b6c9d3;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--motion-micro) var(--motion-ease),
      color var(--motion-micro) var(--motion-ease),
      border-color var(--motion-micro) var(--motion-ease);
  }

  .fieldnotes-controls button:hover,
  .fieldnotes-controls button[aria-pressed="true"] {
    border-color: rgba(255, 255, 255, 0.72);
    background: #fff;
    color: var(--marine);
  }

  .fieldnote {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    min-height: 29rem;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .fieldnote[hidden] {
    display: none;
  }

  .fieldnote__index {
    margin-bottom: 1rem;
    color: #7fb3ce;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .fieldnote h3 {
    max-width: 14ch;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .fieldnote > div > p:not(.fieldnote__index) {
    max-width: 36rem;
    margin-top: 1.25rem;
    color: #b9cbd4;
    font-size: 0.93rem;
    line-height: 1.7;
  }

  .fieldnote .fieldnote__hint {
    margin-top: 0.75rem;
    color: #7f9aa8;
    font-size: 0.78rem;
  }

  .fieldnote .text-link {
    margin-top: 1.4rem;
    color: #fff;
    font-size: 0.82rem;
  }

  .fieldnote figure {
    min-width: 0;
  }

  .fieldnote figure img {
    width: 100%;
    max-height: 34rem;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .fieldnote figcaption {
    margin-top: 0.65rem;
    color: #7f9aa8;
    font-size: 0.72rem;
  }

  .fieldnote-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .fieldnote-photos a {
    display: block;
    text-decoration: none;
  }

  .fieldnote-photos img {
    aspect-ratio: 3 / 4;
    transition:
      transform var(--motion-ui) var(--motion-ease),
      opacity var(--motion-ui) var(--motion-ease);
  }

  .fieldnote-photos a:hover img {
    transform: translateY(-3px);
    opacity: 0.88;
  }

  @media (min-width: 54rem) {
    .fieldnote {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    }
  }

  @media (max-width: 47.99rem) {
    .fieldnotes-top {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 30rem) {
    .fieldnote-photos {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fieldnotes-controls button,
    .fieldnote-photos img {
      transition: none;
    }

    .fieldnote-photos a:hover img {
      transform: none;
    }
  }
</style>
