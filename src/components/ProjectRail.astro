---
import type { MarkdownHeading } from "astro";
interface Props {
  headings: MarkdownHeading[];
}
const sections = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{sections.length > 1 && (
  <details class="study-contents" open data-study-contents>
    <summary>
      In this study <span aria-hidden="true">↕</span>
    </summary>
    <nav class="project-rail" aria-label="Project sections" data-project-rail>
      <ol>
        {sections.map((heading, i) => (
          <li>
            <a href={`#${heading.slug}`} data-project-rail-link={heading.slug}>
              <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
      <div class="study-progress" aria-hidden="true">
        <span />
      </div>
    </nav>
  </details>
)}
<script>
  import "../scripts/project-rail";
</script>
<style>
  .study-contents {
    border-top: 2px solid var(--project-accent);
    border-bottom: 1px solid var(--border);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 48px;
    padding: 0.8rem 0;
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--project-accent);
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    font-size: 1rem;
  }
  ol {
    padding: 0;
    margin: 0 0 0.8rem;
    list-style: none;
  }
  a {
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    min-height: 40px;
    padding: 0.65rem 0.35rem;
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.4;
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  a span {
    font-size: 0.6rem;
    font-variant-numeric: tabular-nums;
  }
  a:hover,
  a[aria-current="true"] {
    color: var(--project-accent);
    background: color-mix(in srgb, var(--project-accent) 5%, white);
  }
  a[aria-current="true"] {
    border-left-color: var(--project-accent);
    font-weight: 650;
  }
  .study-progress {
    height: 2px;
    background: var(--border);
  }
  .study-progress span {
    display: block;
    height: 100%;
    width: var(--project-rail-progress, 0%);
    background: var(--project-accent);
  }
  @media (min-width: 64rem) {
    summary span {
      display: none;
    }
  }
  @media (max-width: 63.99rem) and (min-width: 40rem) {
    ol {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
