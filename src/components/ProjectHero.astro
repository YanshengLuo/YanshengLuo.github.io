---
import type { CollectionEntry } from "astro:content";
import { emphasize } from "../utils/format";
interface Props {
  data: CollectionEntry<"research">["data"];
  number: string;
  domain: string;
}
const { data, number, domain } = Astro.props;
---
<header class="project-head">
  <div class="project-head__rail">
    <p class="project-head__index">Research / {number}</p>
    <p class="project-head__domain">{domain}</p>
  </div>
  <div class="project-head__main">
    <p class="project-head__label">{data.label}</p>
    <h1 class="project-head__title" set:html={emphasize(data.title)} />
    <p class="project-head__intro" set:html={emphasize(data.intro)} />
  </div>
</header>
<style>
  /* Each route carries its project color as a quiet wash, so the four pages
     do not read as one template. */
  .project-head::before {
    content: "";
    position: absolute;
    inset: -1.5rem -1.25rem auto;
    height: calc(100% + 3rem);
    z-index: -1;
    border-radius: var(--radius-lg);
    background: linear-gradient(155deg, color-mix(in srgb, var(--project-accent) 10%, white), transparent 72%);
  }

  .project-head { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); padding-block: clamp(3rem, 6vw, 5.5rem); }
  .project-head__rail { display: flex; justify-content: space-between; gap: 1rem; border-top: 2px solid var(--project-accent); padding-top: .8rem; }
  .project-head__index, .project-head__domain, .project-head__label { color: var(--project-accent); font-size: .7rem; font-weight: 700; letter-spacing: .075em; text-transform: uppercase; }
  .project-head__rail { grid-column: 1 / 4; min-width: 0; }
  .project-head__main { grid-column: 4 / -1; min-width: 0; }
  .project-head__label { color: var(--muted); }
  .project-head__title { max-width: 20ch; margin-top: .85rem; font-size: var(--type-project); font-weight: 600; line-height: 1.04; letter-spacing: -.05em; text-wrap: balance; }
  .project-head__intro { max-width: 58ch; margin-top: 1.6rem; font-size: clamp(1.15rem, 1.5vw, 1.45rem); line-height: 1.48; }
  @media (min-width: 1200px) { .project-head__rail { display: block; } .project-head__domain { margin-top: 1rem; } }
  @media (max-width: 1199px) { .project-head__rail { grid-column: 1 / -1; } .project-head__main { grid-column: 1 / -1; } }
  @media (max-width: 47.99rem) { .project-head { padding-top: 2.25rem; } }
</style>
