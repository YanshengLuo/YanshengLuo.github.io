---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PdacEvidenceModel from "./PdacEvidenceModel.astro";
import ImrsTransfer from "./ImrsTransfer.astro";
import ProteinDecisionFunnel from "./ProteinDecisionFunnel.astro";
import ResearchThroughline from "./ResearchThroughline.astro";
import scienceBoba from "../assets/profile/science-boba.webp";
import scuba from "../assets/profile/scuba.webp";
import poster from "../assets/research/regeneration/poster-thumbnail.webp";
import { figures } from "../data/figures";
import { currentResearchIntro, homeAboutPreview, beyondResearch } from "../data/profile";
import { selectedOutputs } from "../data/work";
import { links } from "../data/social";
import { researchRoute } from "../data/research";
import { emphasize } from "../utils/format";
import "../styles/home-v3.css";

const projects = (await getCollection("research")).sort((a, b) => a.data.order - b.data.order);
const primary = projects.filter((p) => p.data.tier === "primary");
const regeneration = projects.find((p) => p.id === "regeneration");
const protein = projects.find((p) => p.id === "protein-design");
if (!regeneration || !protein || primary.length !== 2) throw new Error("Research hierarchy is incomplete");
const drg = figures["drg-culture"];
const outputTypes = ["Poster / lightning talk", "Accepted manuscript", "Manuscript", "Poster"];
const outputClasses = ["pdac", "drg", "imrs", "poster"];
---

<ResearchThroughline />

<section id="current" class="current-section" data-chapter="current" aria-labelledby="current-title">
  <p class="current-section__word" aria-hidden="true">Research</p>
  <div class="container">
    <header class="folio-head">
      <p class="folio-index">02 / Current research</p>
      <div>
        <h2 id="current-title">Two current problems, one standard for evidence.</h2>
        <p>{currentResearchIntro}</p>
      </div>
    </header>

    <div class="features">
      {
        primary.map((project, index) => (
          <article class:list={["feature", project.id === "pdac" ? "feature--pdac" : "feature--imrs"]}>
            <div class="feature__copy">
              <p class="feature__domain">
                <i aria-hidden="true" />
                {project.data.homeMeta}
              </p>
              <h3>
                <a href={researchRoute(project.id)}>{project.data.homeTitle ?? project.data.title}</a>
              </h3>
              <p class="feature__summary" set:html={emphasize(project.data.summary)} />
              <p class="feature__role">
                <span>My role /</span>
                {project.id === "pdac"
                  ? "clone prioritization, R analysis, and experimental work"
                  : "framework design, transfer tests, and sensitivity analysis"}
              </p>
              <a class="folio-link" href={researchRoute(project.id)}>
                {project.id === "pdac" ? "Read the case study" : "Read the method story"} <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="feature__visual">
              <p class="feature__number" aria-hidden="true">0{index + 1}</p>
              {project.id === "pdac" ? (
                <PdacEvidenceModel id="home-pdac-evidence" />
              ) : (
                <ImrsTransfer id="home-imrs-transfer" />
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section
  id="acomys"
  class="acomys-section"
  data-chapter="acomys"
  data-tone="dark"
  aria-labelledby="acomys-title"
>
  <div class="container acomys-layout">
    <div class="micro-stage">
      <figure class="micro-main">
        <a href={researchRoute(regeneration.id)} aria-label="Open the regeneration research project">
          <Image src={drg.src} alt={drg.alt} widths={[600, 900, 1200]} sizes="(min-width: 75rem) 640px, 92vw" />
        </a>
        <figcaption>Actual research image / DRG explant culture</figcaption>
      </figure>
      <figure class="poster-tile">
        <Image
          src={poster}
          alt="Research poster from the Acomys DRG explant study, presented at a University of Florida symposium."
          widths={[320, 520, 760]}
          sizes="(min-width: 75rem) 320px, 45vw"
        />
        <figcaption>Accepted manuscript + research poster</figcaption>
      </figure>
    </div>

    <div class="acomys-copy">
      <p class="folio-index">03 / Experimental foundation</p>
      <p class="acomys-copy__lab">{regeneration.data.homeMeta}</p>
      <h2 id="acomys-title"><em>Acomys</em> made the question tangible.</h2>
      <p set:html={emphasize(regeneration.data.summary)} />
      <blockquote>
        The result identifies an architectural phenotype. The cellular and extracellular mechanisms
        that generate that organization remain open questions.
      </blockquote>
      <a class="folio-link" href={researchRoute(regeneration.id)}>
        Regeneration project <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<section id="protein" class="protein-section" data-chapter="protein" aria-labelledby="protein-title">
  <div class="container protein-layout">
    <div class="protein-copy">
      <p class="folio-index">04 / Supporting quantitative work</p>
      <p class="protein-copy__lab">{protein.data.homeMeta}</p>
      <h2 id="protein-title">{protein.data.homeTitle ?? protein.data.title}</h2>
      <p set:html={emphasize(protein.data.summary)} />
      <a class="folio-link" href={researchRoute(protein.id)}>
        Protein design project <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="protein-card">
      <ProteinDecisionFunnel id="home-protein-funnel" />
    </div>
  </div>
</section>

<section id="outputs" class="outputs-section" data-chapter="outputs" aria-labelledby="outputs-title">
  <div class="container">
    <header class="folio-head">
      <p class="folio-index">05 / Public record</p>
      <div>
        <h2 id="outputs-title">Posters, manuscripts, and research in motion.</h2>
      </div>
    </header>

    <div class="outputs-layout">
      <ol class="output-list">
        {
          selectedOutputs.map((entry, index) => (
            <li class:list={["output", "output--" + outputClasses[index]]}>
              <span class="output__when">{entry.when ?? "—"}</span>
              <div class="output__body">
                <p class="output__type">{outputTypes[index]}</p>
                <h3>
                  <a href={entry.project} set:html={emphasize(entry.title)} />
                </h3>
                <p class="output__venue" set:html={emphasize(entry.venue ?? "")} />
                <div class="output__mobile-preview">
                  {index === 1 && <Image src={drg.src} alt={drg.alt} widths={[300, 480]} sizes="90vw" />}
                  {index === 3 && (
                    <Image
                      src={poster}
                      alt="Public research poster from the Acomys comparative regeneration study."
                      widths={[300, 480]}
                      sizes="90vw"
                    />
                  )}
                  {index === 0 && <span>MD Anderson / poster + lightning talk</span>}
                  {index === 2 && <span>Fixed score definition, transfer tested</span>}
                </div>
              </div>
              <span class="output__go" aria-hidden="true">↗</span>
            </li>
          ))
        }
      </ol>

      <div class="output-preview" aria-hidden="true">
        <div class="output-preview__panel preview--pdac">
          <span class="output-preview__stamp">MD Anderson / 2026</span>
          <strong>Poster<br />+ lightning talk</strong>
          <span class="output-preview__footer">Public presentation / no study figures</span>
        </div>
        <figure class="output-preview__panel preview--drg">
          <Image
            src={drg.src}
            alt="Fluorescence image of a dorsal root ganglion explant in culture."
            widths={[360, 600]}
            sizes="360px"
          />
          <figcaption>DRG explant / Acomys manuscript</figcaption>
        </figure>
        <div class="output-preview__panel preview--imrs">
          <span class="output-preview__stamp">Song Lab / manuscript</span>
          <strong>One definition.<br />Independent transfer.</strong>
          <span class="output-preview__footer">Frozen-weight response framework</span>
        </div>
        <figure class="output-preview__panel preview--poster">
          <Image
            src={poster}
            alt="Public research poster from the Acomys comparative regeneration study."
            widths={[360, 600]}
            sizes="360px"
          />
          <figcaption>Comparative regeneration poster / 2025</figcaption>
        </figure>
      </div>
    </div>

    <p class="outputs__more">
      <a class="folio-link" href="/work/">All work <span aria-hidden="true">↗</span></a>
    </p>
  </div>
</section>

<section id="about" class="home-about" data-chapter="about" data-tone="dark" aria-labelledby="about-preview-title">
  <div class="container home-about__grid">
    <div class="home-about__collage">
      <figure class="home-about__figure home-about__figure--tall">
        <Image
          src={scienceBoba}
          alt="Yansheng Luo beside his Science Boba polymer chemistry outreach demonstration board."
          widths={[360, 560, 760]}
          sizes="(min-width: 75rem) 320px, 45vw"
        />
        <figcaption>Outreach / Science Boba demonstration</figcaption>
      </figure>
      <figure class="home-about__figure">
        <Image
          src={scuba}
          alt="Yansheng Luo in scuba gear at the surface of a clear freshwater spring."
          widths={[360, 560, 760]}
          sizes="(min-width: 75rem) 320px, 45vw"
        />
        <figcaption>Outside research / diving &amp; marine science</figcaption>
      </figure>
    </div>

    <div class="home-about__copy">
      <p class="folio-index">06 / About</p>
      <h2 id="about-preview-title">Research is one part of the person.</h2>
      <p>{homeAboutPreview.intro}</p>
      <div class="home-about__notes">
        <div>
          <b>Outside the lab</b>
          <span>{beyondResearch.split(".")[0].replace("Outside the lab, I am", "I am")}.</span>
        </div>
        <div>
          <b>Science communication</b>
          <span>{homeAboutPreview.communication}</span>
        </div>
      </div>
      <p class="home-about__links">
        <a href="/about/">More about me <span aria-hidden="true">↗</span></a>
        <a href="/cv/">CV <span aria-hidden="true">↗</span></a>
        <a href={links.email}>Email <span aria-hidden="true">↗</span></a>
      </p>
    </div>
  </div>
</section>
