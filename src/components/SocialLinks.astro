---
import { socialLinks } from "../data/social";

interface Props {
  /** "list": label + handle rows (footer, About). "compact": labels only. */
  variant?: "list" | "compact";
}

const { variant = "list" } = Astro.props;
---

<ul class:list={["social", `social--${variant}`]}>
  {
    socialLinks.map((link) => (
      <li>
        <a href={link.href}>
          <span class="social__label">{link.label}</span>
          {variant === "list" && <span class="social__handle">{link.display}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.75rem;
    min-height: 44px;
    padding-block: 0.6rem;
    text-decoration: none;
    color: var(--text);
  }

  .social a:hover .social__label {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .social--list li + li {
    border-top: 1px solid var(--border);
  }

  .social__label {
    min-width: 5.5rem;
    font-weight: 500;
  }

  .social__handle {
    color: var(--muted);
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }

  .social--compact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .social--compact .social__label {
    min-width: 0;
  }
</style>
