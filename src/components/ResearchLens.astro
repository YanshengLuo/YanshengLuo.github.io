---
const pathways = [
  {
    id: "pdac",
    label: "PDAC",
    title: "Follow the lineage. Question the pattern.",
    accent: "var(--pdac)",
    href: "/research/pdac-clonal-evolution/",
    steps: [
      [
        "Observe",
        "Clonal histories",
        "Barcode lineage tracing follows PDAC lineages across distinct therapeutic perturbations in the context of KRAS suppression.",
      ],
      [
        "Test",
        "Converging evidence",
        "Recurrence, abundance, effect size, treatment specificity and trajectories are evaluated alongside robustness.",
      ],
      [
        "Interpret",
        "Resistance-associated patterns",
        "Prioritized clonal patterns are considered alongside quality-controlled mass-spectrometry profiles.",
      ],
    ],
    limit:
      "Associations in a model system do not establish a biological mechanism. Clone-level results remain unpublished.",
  },
  {
    id: "imrs",
    label: "IMRS",
    title: "Fix the definition. Test its transfer.",
    accent: "var(--imrs)",
    href: "/research/imrs/",
    steps: [
      [
        "Observe",
        "Anchor contrasts",
        "Within-study treatment–control contrasts provide the evidence for a shared response definition.",
      ],
      [
        "Test",
        "An unchanged score",
        "The gene set and weights stay fixed during independent validation, sensitivity tests and cross-species evaluation.",
      ],
      [
        "Interpret",
        "A response axis",
        "Transfer tests ask how consistently the same transcriptomic definition behaves across datasets.",
      ],
    ],
    limit:
      "A transcriptomic response score is not a clinical outcome predictor or evidence of a causal pathway. Manuscript prepared for submission.",
  },
  {
    id: "regeneration",
    label: "Regeneration",
    title: "Start with the tissue. Compare the phenotype.",
    accent: "var(--acomys)",
    href: "/research/regeneration/",
    steps: [
      [
        "Observe",
        "A comparative model",
        "Acomys and Mus provide a comparison of regenerative and fibrotic responses to peripheral nerve injury.",
      ],
      [
        "Test",
        "From injury to culture",
        "Sciatic nerve injury models, histology, immunostaining and DRG explant cultures connect tissue context with cellular organization.",
      ],
      [
        "Interpret",
        "Architecture in context",
        "Quantitative imaging supports comparison of explant organization and tissue repair phenotypes.",
      ],
    ],
    limit:
      "The displayed vimentin image labels non-neuronal structural cells; it is not a neuron-specific stain. Manuscript accepted for publication.",
  },
  {
    id: "protein-design",
    label: "Protein design",
    title: "Generate candidates. Make selection accountable.",
    accent: "var(--protein)",
    href: "/research/protein-design/",
    steps: [
      [
        "Observe",
        "A candidate landscape",
        "The public 2025 osteocalcin campaign generated more than 500 computational binder candidates.",
      ],
      [
        "Test",
        "Multiple ranking signals",
        "Structural confidence, interface quality, steric clashes, solvent exposure and interaction metrics inform prioritization.",
      ],
      [
        "Interpret",
        "Candidates for experiments",
        "Ten candidates were prioritized; three were selected for wet-lab testing in the public 2025 workflow.",
      ],
    ],
    limit:
      "Computational ranking is a selection aid, not a measurement of binding affinity or proof of experimental success.",
  },
];
---

<section class="research-lens" data-research-lens aria-labelledby="lens-title">
  <header class="lens-head">
    <div>
      <p class="lens-kicker">An evidence question, four approaches</p>
      <h2 id="lens-title">What makes a difference worth interpreting?</h2>
    </div>
    <p>
      Explore what each project observes, how it tests the evidence, and where
      interpretation stops.
    </p>
  </header>
  <div class="lens-controls" hidden>
    <div
      class="lens-options"
      role="group"
      aria-label="Choose a research approach"
    >
      {pathways.map((path, i) => (
        <button
          type="button"
          data-lens-choice={path.id}
          aria-pressed={i === 0 ? "true" : "false"}
          aria-controls={`lens-${path.id}`}
          style={`--lens-accent:${path.accent}`}
        >
          <span aria-hidden="true">0{i + 1}</span>
          {path.label}
        </button>
      ))}
    </div>
    <button
      class="lens-compare"
      type="button"
      data-lens-compare
      aria-pressed="false"
    >
      Compare all four <span aria-hidden="true">↓</span>
    </button>
  </div>
  <p
    class="visually-hidden"
    data-lens-status
    role="status"
    aria-live="polite"
  ></p>
  <div class="lens-panels">
    {pathways.map((path) => (
      <article
        class="lens-panel"
        id={`lens-${path.id}`}
        data-lens-panel={path.id}
        style={`--lens-accent:${path.accent}`}
        aria-labelledby={`lens-heading-${path.id}`}
      >
        <header class="lens-panel-head">
          <p>{path.label}</p>
          <h3 id={`lens-heading-${path.id}`}>{path.title}</h3>
        </header>
        <ol class="lens-steps">
          {path.steps.map((step, i) => (
            <li>
              <p class="lens-step-label">
                <span aria-hidden="true">0{i + 1}</span>
                {step[0]}
              </p>
              <h4>{step[1]}</h4>
              <p>{step[2]}</p>
            </li>
          ))}
        </ol>
        <div class="lens-boundary">
          <p>
            <strong>Interpretation boundary</strong>
            {path.limit}
          </p>
          <a href={path.href}>
            Read the study <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>
  <p class="lens-note">
    A map of research approaches. The connecting lines describe reasoning, not
    measured relationships between projects.
  </p>
</section>
<script>
  import "../scripts/research-lens";
</script>
<style>
  .research-lens {
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .lens-head {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .lens-kicker {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .lens-head h2 {
    max-width: 23ch;
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    letter-spacing: -0.045em;
    line-height: 1.1;
  }
  .lens-head > p {
    max-width: 40ch;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .lens-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .lens-controls[hidden],
  .lens-panel[hidden] {
    display: none;
  }
  .lens-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .lens-options button,
  .lens-compare {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    min-height: 44px;
    padding: 0.65rem 0.9rem;
    cursor: pointer;
  }
  .lens-options button {
    border: 1px solid var(--border);
    background: transparent;
    color: var(--ink-2);
    border-bottom: 3px solid transparent;
  }
  .lens-options button span {
    margin-right: 0.55rem;
    font-size: 0.65rem;
    color: var(--lens-accent);
  }
  .lens-options button[aria-pressed="true"] {
    border-bottom-color: var(--lens-accent);
    background: color-mix(in srgb, var(--lens-accent) 6%, white);
    color: var(--lens-accent);
  }
  .lens-options button:hover {
    border-color: var(--lens-accent);
  }
  .lens-compare {
    border: 0;
    background: transparent;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lens-panel {
    border-top: 2px solid var(--lens-accent);
    padding: 1.5rem 0 0;
    margin-bottom: 2rem;
  }
  .lens-panel-head {
    display: flex;
    align-items: baseline;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .lens-panel-head > p {
    color: var(--lens-accent);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .lens-panel h3 {
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    letter-spacing: -0.025em;
  }
  .lens-steps {
    display: grid;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
    margin: 0;
  }
  .lens-steps li {
    min-width: 0;
    position: relative;
    border-top: 1px solid color-mix(in srgb, var(--lens-accent) 30%, white);
    padding-top: 1rem;
  }
  .lens-step-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--lens-accent);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .lens-step-label span {
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.6rem;
  }
  .lens-steps h4 {
    margin: 0.85rem 0 0.5rem;
    font-size: 1.12rem;
    letter-spacing: -0.025em;
  }
  .lens-steps li > p:last-child {
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.65;
    max-width: 48ch;
  }
  .lens-boundary {
    display: flex;
    gap: 1rem 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
    padding: 1.1rem 1.25rem;
    border-left: 2px solid var(--lens-accent);
    background: color-mix(in srgb, var(--lens-accent) 5%, white);
  }
  .lens-boundary p {
    max-width: 78ch;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .lens-boundary strong {
    display: block;
    color: var(--lens-accent);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.045em;
    margin-bottom: 0.3rem;
  }
  .lens-boundary a {
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--lens-accent);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lens-note {
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.6;
    max-width: 80ch;
  }
  @media (min-width: 48rem) {
    .lens-head {
      grid-template-columns: 1.4fr 1fr;
    }
    .lens-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
    .lens-steps li:not(:last-child)::after {
      content: "→";
      position: absolute;
      right: -1.5rem;
      top: -0.8rem;
      background: var(--surface);
      color: var(--lens-accent);
    }
  }
  @media (max-width: 47.99rem) {
    .lens-options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }
    .lens-options button {
      text-align: left;
    }
    .lens-boundary {
      align-items: start;
      flex-direction: column;
    }
    .lens-panel-head {
      gap: 0.5rem;
    }
    .lens-panel-head > p {
      width: 100%;
    }
  }
</style>
